meta {
  name: Listar Entrenadores
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/entrenadores
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  buscar:
  activo:
}

script:post-response {
  const found = (res.body.empleados || []).find(e => e.correo === "pedro.lopez@gymsuite.com");
  if (found) bru.setVar("entrenadorId", found._id);
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.empleados).to.be.an("array");
  });
}
