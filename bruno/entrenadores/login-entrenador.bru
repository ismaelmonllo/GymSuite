meta {
  name: Login Entrenador
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "pedro.lopez@gymsuite.com",
    "contrasena": "Entren1234"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenEntrenador", res.body.token);
  }
}

tests {
  test("login entrenador exitoso", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("token");
  });
}
