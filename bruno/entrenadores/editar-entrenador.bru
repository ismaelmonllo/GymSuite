meta {
  name: Editar Entrenador
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/entrenadores/{{entrenadorId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Carlos",
    "apellidos": "Martínez Ruiz",
    "telefono": "699887766"
  }
}

tests {
  test("edita con 200", function() {
    expect(res.status).to.equal(200);
  });
}
