meta {
  name: Crear Entrenador
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/entrenadores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Carlos",
    "apellidos": "Martínez Ruiz",
    "correo": "carlos.martinez@gymsuite.com",
    "contrasena": "password123",
    "telefono": "623456789",
    "DNI": "87654321B",
    "rol": "entrenador"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("entrenadorId", res.body._id);
  }
}

tests {
  test("crea entrenador con 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("_id");
  });
}
