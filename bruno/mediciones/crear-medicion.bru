meta {
  name: Crear Medición
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/mediciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEntrenador}}
}

body:json {
  {
    "cliente_id": "{{clienteId}}",
    "fecha": "2026-04-20",
    "peso": 75.5,
    "altura": 178,
    "porcentaje_grasa": 18.2,
    "cuello": 38,
    "hombros": 112,
    "pecho_ins": 95,
    "pecho_exp": 100,
    "cintura": 82,
    "cadera": 96,
    "muslo": 55,
    "gemelo": 36,
    "brazo": 32,
    "antebrazo": 26,
    "biceps": 8,
    "triceps": 12,
    "subescapular": 14,
    "cresta_iliaca": 16,
    "observaciones": "Primera medición de control"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("medicionId", res.body._id);
  }
}

tests {
  test("crea medición con 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("_id");
  });
}
