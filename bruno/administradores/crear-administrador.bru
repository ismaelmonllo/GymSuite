meta {
  name: Crear Administrador
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/administradores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Laura",
    "apellidos": "Sánchez Pérez",
    "correo": "laura.sanchez@gymsuite.com",
    "contrasena": "password123",
    "telefono": "634567890",
    "DNI": "11223344C",
    "rol": "admin"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("adminId", res.body._id);
  }
}

tests {
  test("crea admin con 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("_id");
  });
}
