meta {
  name: Generar Pagos del Mes (cron)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/pagos/generar-cron
  body: none
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

tests {
  test("genera, confirma o rechaza sin secret", function() {
    expect([200, 201, 401]).to.include(res.status);
  });
}
