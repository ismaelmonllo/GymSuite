meta {
  name: Listar Cuotas
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/cuotas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.cuotas && res.body.cuotas.length > 0) {
    bru.setVar("cuotaId", res.body.cuotas[0]._id);
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.cuotas).to.be.an("array");
  });
}
