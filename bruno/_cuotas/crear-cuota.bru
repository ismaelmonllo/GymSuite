meta {
  name: Crear Cuota
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/cuotas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Mensual",
    "meses": 1,
    "importe": 40
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("cuotaId", res.body.cuota._id);
  }
}

tests {
  test("crea cuota con 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body.cuota).to.have.property("_id");
  });
}
