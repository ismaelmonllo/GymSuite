meta {
  name: Login Cliente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "ana.ruiz@ejemplo.com",
    "contrasena": "Cliente1234"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenCliente", res.body.token);
  }
}

tests {
  test("login cliente exitoso", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("token");
  });
}
