meta {
  name: Editar Cliente
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/clientes/{{clienteId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Juan",
    "apellidos": "García López",
    "telefono": "698765432",
    "direccion": "Calle Nueva 5, Madrid",
    "nivel": "intermedio"
  }
}

tests {
  test("edita con 200", function() {
    expect(res.status).to.equal(200);
  });
}
