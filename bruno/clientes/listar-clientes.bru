meta {
  name: Listar Clientes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/clientes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  buscar:
  nivel:
  activo:
}

script:post-response {
  const found = (res.body.clientes || []).find(c => c.correo === "ana.ruiz@ejemplo.com");
  if (found) bru.setVar("clienteId", found._id);
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.clientes).to.be.an("array");
  });
}
