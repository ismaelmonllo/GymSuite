meta {
  name: Crear Cliente
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Juan",
    "apellidos": "García López",
    "correo": "juan.garcia@ejemplo.com",
    "contrasena": "password123",
    "telefono": "612345678",
    "direccion": "Calle Mayor 1, Madrid",
    "fecha_nacimiento": "1990-05-15",
    "DNI": "12345678A",
    "nivel": "principiante",
    "tipo_cuota": "{{cuotaId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("clienteId", res.body._id);
  }
}

tests {
  test("crea cliente con 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("_id");
  });
}
