# MongoDB
MONGODB_URI=            # URI principal (MongoDB Atlas). Obligatoria.
MONGODB_URI_BACKUP=     # URI de respaldo. Probada si la principal falla.

# JWT
JWT_SECRET=             # Secret para tokens de acceso (15m). Mínimo 32 chars. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=     # Secret para refresh tokens (7d). Distinto de JWT_SECRET.

# Cron
CRON_SECRET=            # Valor para la cabecera x-cron-secret.

# Email (Gmail con app password)
EMAIL_USER=             # gymsuite.security@gmail.com
EMAIL_PASS=             # App password de Google (16 chars). NO la contraseña real. Generar en https://myaccount.google.com/apppasswords

# Entorno
NODE_ENV=production     # Solo en prod. Activa sameSite=none, secure=true en cookies. NO setear en dev.
FRONTEND_URL=           # URL del frontend en prod. Obligatoria en prod.
PORT=5000               # Solo dev. Ignorado en Vercel (serverless).

# Opcionales
DISABLE_2FA=            # 'true' en dev para saltar el OTP. Ignorado si NODE_ENV=production.
BCRYPT_ROUNDS=          # Rondas de bcrypt. Default 12.
